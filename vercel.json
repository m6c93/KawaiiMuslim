    },
    {
      "source": "/coran-licence/administration.html",
      "has": [{ "type": "host", "value": "presentation.coran.kawaiimuslimworld.com" }],
      "destination": "/presentation-coran/",
      "permanent": false
    },
    {
      "source": "/administration.html",
      "has": [{ "type": "host", "value": "presentation.coran.kawaiimuslimworld.com" }],
      "destination": "/presentation-coran/",
      "permanent": false
    },
    {
      "source": "/Admin.dc.html",
      "has": [{ "type": "host", "value": "presentation.coran.kawaiimuslimworld.com" }],
      "destination": "/presentation-coran/",
      "permanent": false
    },
    {
