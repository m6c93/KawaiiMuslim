{
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "coran.kawaiimuslimworld.com" }],
      "destination": "/coran-licence/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/coran-licence/demonstration.html",
      "destination": "/presentation-coran/",
      "permanent": false
    },
