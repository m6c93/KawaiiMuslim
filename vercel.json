      "has": [{ "type": "host", "value": "presentation.coran.kawaiimuslimworld.com" }],
      "destination": "/presentation-coran/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "presentation.coran.kawaiimuslimworld.com" }],
      "destination": "/presentation-coran/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "coran.kawaiimuslimworld.com" }],
      "destination": "/coran-licence/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "newsletter.kawaiimuslimworld.com" }],
      "destination": "/newsletter/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/newsletter/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/newsletter",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
